# AI API Credentials Template
# Copy this file to .env and insert your real keys locally.
# DO NOT commit real keys to version control (Git).

# Server-Side Secret Keys (Used by Vercel Serverless Functions at /api/groq and /api/gemini)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Client-Side Public Keys
VITE_HF_API_KEY=your_huggingface_token_here

# ── 3D Avatar voice (/api/tts) ──
# Provider: gemini (default, uses GEMINI_API_KEY) | groq (uses GROQ_API_KEY) | openai (uses OPENAI_API_KEY)
TTS_PROVIDER=gemini
# Optional voice override. Gemini: Kore, Puck, Aoede, Charon… | Groq: hannah, troy, fahad… | OpenAI: alloy, nova…
# TTS_VOICE=Kore
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── 3D Avatar model ──
# Optional custom GLB avatar (served from public/). Empty = built-in robot.
# VITE_AVATAR_MODEL_URL=/models/avatar.glb
