# AI API Credentials Template
# Copy this file to .env and insert your real keys locally.
# DO NOT commit real keys to version control (Git).

# Server-Side Secret Keys (Used by Vercel Serverless Functions at /api/groq and /api/gemini)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Client-Side Public Keys
VITE_HF_API_KEY=your_huggingface_token_here
